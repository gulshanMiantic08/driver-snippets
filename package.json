{
  "name": "driver-snippets",
  "displayName": "Driver Snippets",
  "description": "Private VS Code snippets for Miantic Development Team",
  "version": "1.0.0",
  "publisher": "gulshanMiantic08",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:javascript"
  ],
  "main": "./extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gulshanMiantic08/driver-snippets.git"
  }
}